<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.matsuo.elm</groupId>
    <artifactId>elm-lang</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <!-- Truffle / GraalVM version; must match the running GraalVM JDK (25.0.2). -->
        <graalvm.version>25.0.2</graalvm.version>
        <!-- Empty by default; the `coverage` profile's JaCoCo agent fills it in (see propertyName).
             Surefire's argLine references it so the agent and our -Xss flag coexist. -->
        <jacocoArgLine/>
        <!-- JUnit tag groups excluded from the default `mvn test` (the fast inner-loop suite):
             `bench` = performance benchmarks, `browser` = real-Chrome rendering, `slow` = the heavy
             full-gallery integration tests (every example compiled to JS+WASM). Run the full set
             with `-Pfull` (or `mvn verify`), or override with `-Dtest.excludedGroups=…`. A couple of
             light gallery smoke tests (GalleryBuildTest, SiteGenTest) stay in the fast suite. -->
        <test.excludedGroups>bench,browser,slow</test.excludedGroups>
        <!-- Surefire JVM forks. Each fork is a full GraalVM/Truffle JVM (an optimizing runtime that
             is memory- and init-heavy), so this is a quarter of the cores rather than a half: too
             many concurrent Truffle runtimes exhaust memory and surface as NoClassDefFoundError on
             generated nodes. The `C` suffix scales with the machine, so small CI runners stay at
             1-2 forks. Independent classes only: server tests bind ephemeral ports and DB tests use
             unique in-memory databases, so parallelism here is contention, not a correctness risk. -->
        <test.forkCount>0.25C</test.forkCount>
        <!-- Within-class method-level concurrency (for @Execution(CONCURRENT) classes). On by
             default for the fast suite; the `full` profile turns it off to keep the heavier run
             within memory. -->
        <test.parallel>true</test.parallel>
    </properties>

    <dependencies>
        <!-- Truffle language framework: the JIT interpreter is a Truffle language;
             on GraalVM the Graal compiler partial-evaluates hot AST nodes. -->
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-api</artifactId>
            <version>${graalvm.version}</version>
        </dependency>
        <!-- Optimizing Truffle runtime (auto-detects the Graal compiler in the JDK). -->
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${graalvm.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Polyglot embedding API: lets the CLI/tests evaluate Elm via a Context. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.6</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Pure-Java JDBC driver backing the `Db` server library (in-memory for tests, file/server
             for deployment). Any JDBC driver on the classpath works; H2 ships by default. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
        </dependency>
    </dependencies>

    <build>
        <!-- The bundled Elm *sources* live under src/main/elm (kept apart from non-Elm assets), while
             stylesheets, scripts and HTML stay under the conventional src/main/resources/elm. Both are
             packaged onto the classpath under /elm/… (src/main/elm via targetPath), so every
             getResourceAsStream("/elm/…") keeps working unchanged. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/elm</directory>
                <targetPath>elm</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.graalvm.truffle</groupId>
                            <artifactId>truffle-dsl-processor</artifactId>
                            <version>${graalvm.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- The editor's Elm-in-Elm evaluator (Eval.elm) is a tree-walker run *by* the
                         main interpreter, so deeply recursive examples (e.g. Conway's Life) nest a
                         lot of Java frames. Give the test JVM a large thread stack so it doesn't
                         overflow on CI's smaller default Linux stack. @{jacocoArgLine} is empty
                         unless the coverage profile is active (late-bound so JaCoCo's
                         prepare-agent, which runs after POM interpolation, can fill it in). -->
                    <argLine>@{jacocoArgLine} -Xss64m</argLine>
                    <!-- Run independent test classes in parallel JVM forks, and skip the slowest
                         opt-in groups (benchmarks, real-browser, slow gallery) in the fast suite. -->
                    <forkCount>${test.forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                    <!-- Within-class method concurrency (junit-platform.properties) is toggled here so
                         the `full` profile can turn it off: under -Pfull the heavy bench/browser/slow
                         tests run too, and forks + method-threads together exhaust memory. -->
                    <properties>
                        <configurationParameters>
                            junit.jupiter.execution.parallel.enabled = ${test.parallel}
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>pl.matsuo.elm.Main</mainClass>
                </configuration>
            </plugin>
            <!-- Standalone runnable fat JAR: java -jar target/elm.jar <command> ... -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>elm</finalName>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>pl.matsuo.elm.Main</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Full suite:  ./mvnw -Pfull test   (or `mvn verify`)
          Runs every test group, including the benchmarks and the real-Chrome rendering tests that
          the default fast suite skips. Use this in CI. Equivalent to `-Dtest.excludedGroups=`.
        -->
        <profile>
            <id>full</id>
            <properties>
                <test.excludedGroups/>
                <!-- The full run also executes the benchmarks, real-Chrome and full-gallery tests,
                     which are individually heavy; with the benchmark (~150s) dominating wall time
                     anyway, trade parallelism for headroom: fewer forks and no method concurrency,
                     so the combined memory footprint stays well under what crashes a Truffle fork. -->
                <test.forkCount>0.125C</test.forkCount>
                <test.parallel>false</test.parallel>
            </properties>
        </profile>
        <!--
          Code coverage:  ./mvnw -Pcoverage test
          Runs the suite under the JaCoCo agent and writes target/site/jacoco/ (HTML + jacoco.xml).
          Kept in a profile so a plain `mvn test` is unaffected (the agent is opt-in).
        -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <!-- Write the agent JVM arg into our own property, which
                                         Surefire's argLine references (so it composes with -Xss
                                         instead of overwriting it). -->
                                    <propertyName>jacocoArgLine</propertyName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Native binary via GraalVM native-image:  ./mvnw -Pnative package
          Produces target/elm(.exe). Requires the platform C toolchain on PATH
          (on Windows: MSVC / "x64 Native Tools" from Visual Studio Build Tools).
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>elm</imageName>
                            <mainClass>pl.matsuo.elm.Main</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-O2</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
